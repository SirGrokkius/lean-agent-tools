#!/usr/bin/env python3
import argparse,datetime,hashlib,json,os,pathlib,re,sqlite3,subprocess,sys,time,urllib.request
def redact(s):
 pats=[r'nsec1[0-9A-Za-z]{10,}',r'\bsk-[A-Za-z0-9_-]{6,}',r'\bgh[pousr]_[A-Za-z0-9]{10,}',r'\bxox[baprs]-[A-Za-z0-9-]+',r'(?i)\b(api_key|token|secret|password|authorization)\s*[:=]\s*\S+',r'\b[0-9a-fA-F]{40,}\b']; n=0
 for p in pats: s,n2=re.subn(p,'[REDACTED]',s);n+=n2
 return s,n
def dur(s):
 m=re.fullmatch(r'(\d+(?:\.\d+)?)([smhd]?)',s)
 if not m: sys.exit(f'aicache: bad duration {s!r} (use e.g. 90s, 30m, 6h, 7d)')
 return float(m.group(1))*{'':1,'s':1,'m':60,'h':3600,'d':86400}[m.group(2)]
def main():
 p=argparse.ArgumentParser(description='Cache deterministic command output or URL bodies')
 p.add_argument('--ttl',default='24h');p.add_argument('--ns',default='default');p.add_argument('--url');p.add_argument('--stats',action='store_true');p.add_argument('--purge',action='store_true');p.add_argument('--older',default='7d');p.add_argument('command',nargs=argparse.REMAINDER)
 a=p.parse_args(); db=os.getenv('AICACHE_DB',os.path.expanduser('~/.cache/aicache/cache.db'));pathlib.Path(db).parent.mkdir(mode=0o700,parents=True,exist_ok=True)
 if a.url and not re.match(r'(?i)https?://',a.url): p.error('--url must be http(s)://')
 c=sqlite3.connect(db);c.execute('create table if not exists cache (key text primary key, created real, output blob, hits integer default 0)');c.execute('create table if not exists metrics (k text primary key,v integer)');c.executemany('insert or ignore into metrics values (?,0)',[('hits',),('misses',),('bytes_saved',)]);c.commit()
 try: os.chmod(db,0o600)
 except OSError: pass
 dur(a.ttl);dur(a.older)
 if a.stats:
  print('entries:',c.execute('select count(*) from cache').fetchone()[0]);print('hits/misses/bytes_saved:',* [c.execute('select v from metrics where k=?',(k,)).fetchone()[0] for k in ('hits','misses','bytes_saved')]);return 0
 if a.purge:
  cur=c.execute('delete from cache where created < ?',(time.time()-dur(a.older),));c.commit();print('purged',cur.rowcount);return 0
 if bool(a.url)==bool(a.command): p.error('use --url URL or -- COMMAND ...')
 argv=a.command[1:] if a.command and a.command[0]=='--' else a.command
 ident='url:'+a.url if a.url else 'cmd:'+json.dumps([a.ns]+argv,separators=(',',':'))
 key=hashlib.sha256(ident.encode()).hexdigest(); row=c.execute('select created,output from cache where key=?',(key,)).fetchone()
 if row and time.time()-row[0]<=dur(a.ttl):
  out=bytes(row[1]);sys.stdout.buffer.write(out);age=int(time.time()-row[0]);print(f'[aicache hit age {age//3600}h{age%3600//60:02d}m]',file=sys.stderr);c.execute('update cache set hits=hits+1 where key=?',(key,));c.execute("update metrics set v=v+1 where k='hits'");c.execute("update metrics set v=v+? where k='bytes_saved'",(len(out),));c.commit();return 0
 c.execute("update metrics set v=v+1 where k='misses'");c.commit()
 try:
  if a.url:
   with urllib.request.urlopen(a.url,timeout=10) as r: out=r.read()
   rc=0
  else:
   if not argv: p.error('command required')
   r=subprocess.run(argv,stdout=subprocess.PIPE,stderr=None);out=r.stdout;rc=r.returncode
 except Exception as e: print('aicache:',str(e),file=sys.stderr);return 1
 s=out.decode('utf-8','replace'); safe,n=redact(s); sys.stdout.write(safe)
 out=safe.encode()
 if rc==0 and out and n==0:
  c.execute('insert or replace into cache values (?,?,?,0)',(key,time.time(),sqlite3.Binary(out)));c.commit()
 return rc
if __name__=='__main__':sys.exit(main())
